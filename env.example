# Telegram Business Assistant Bot - Local Development Environment
# Copy this file: cp .env.example .env && chmod 600 .env
# Railway does NOT use this file. Set the same names as Variables in Railway project settings.

# AI_PROVIDER: "claude" (Claude Code CLI) or "openrouter" (OpenRouter API)
AI_PROVIDER=claude

# REQUIRED: Bot token from @BotFather (format: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# REQUIRED: Your Telegram user ID (number only). Get it from @userinfobot
OWNER_ID=

# AUTO_SEND: false = preview mode (replies only logged), true = send replies automatically
AUTO_SEND=false

# ===== CLAUDE CODE CLI SETTINGS (when AI_PROVIDER=claude) =====
# CLAUDE_CODE_OAUTH_TOKEN: Result of 'claude setup-token' (starts with sk-ant-oat...)
# Run once on a browser machine, token valid for 1 year. Paste in editor as SINGLE LINE.
# Do NOT use echo - it leaves token in shell history. If empty, uses local 'claude login'.
CLAUDE_CODE_OAUTH_TOKEN=

# CLAUDE_BIN: Path to claude binary. Empty = auto-detect (PATH, then ~/.local/bin/claude)
CLAUDE_BIN=

# CLAUDE_MODEL: Model to use. Empty = CLI default.
CLAUDE_MODEL=

# CLAUDE_EFFORT: Reasoning effort. One of: low, medium, high, xhigh, max
CLAUDE_EFFORT=low

# CLAUDE_TIMEOUT_SECONDS: Max seconds to wait for Claude response. Minimum 1.
CLAUDE_TIMEOUT_SECONDS=120

# ===== OPENROUTER SETTINGS (when AI_PROVIDER=openrouter) =====
# OPENROUTER_API_KEY: Get from https://openrouter.ai/keys (starts with sk-or-v1-...)
OPENROUTER_API_KEY=

# OPENROUTER_MODEL: Model to use. See https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# OPENROUTER_BASE_URL: API base URL (usually don't change)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OPENROUTER_TIMEOUT_SECONDS: Max seconds to wait for OpenRouter response. Minimum 1.
OPENROUTER_TIMEOUT_SECONDS=120

# OPENROUTER_MAX_TOKENS: Maximum tokens in response. Minimum 1.
OPENROUTER_MAX_TOKENS=4000

# OPENROUTER_TEMPERATURE: Sampling temperature (0.0-2.0).
OPENROUTER_TEMPERATURE=0.7

# ===== GENERAL SETTINGS =====
# LIMIT_COOLDOWN_MINUTES: Minutes to wait after AI limit before retry. Minimum 1.
LIMIT_COOLDOWN_MINUTES=30

# OWNER_TAKEOVER_MINUTES: Minutes to stay silent after owner sends a message. 0 = disabled.
OWNER_TAKEOVER_MINUTES=15

# HISTORY_LIMIT: Max messages per chat to keep in history. Minimum 1.
HISTORY_LIMIT=30

# DATA_DIR: Data directory (relative to project root). Defaults to data/
# PROFILE_PATH: Profile file path (relative to project root). Defaults to profile.md